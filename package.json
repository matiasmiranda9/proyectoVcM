{
  "name": "aquaeval-vcm",
  "private": true,
  "version": "1.0.0",
  "description": "Prototipo académico de gestión de evaluaciones psicolaborales para el proyecto VcM",
  "type": "module",
  "engines": {
    "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
  },
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:evidence": "vitest run --reporter=default --reporter=json --outputFile=artifacts/vitest-results.json"
  },
  "dependencies": {
    "bootstrap": "5.3.8",
    "lucide-react": "1.61.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@vitejs/plugin-react": "6.1.2",
    "jsdom": "30.1.3",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  }
}
